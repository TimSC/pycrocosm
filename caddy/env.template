# The name the site is reached by. With a public name, and ports 80 and 443
# reachable from the internet, Caddy obtains and renews a certificate itself.
SITE_ADDRESS=maps.example.org

# Where the application listens, as seen from the Caddy container. The default
# is port 8000 on this machine, which the main docker-compose.yml publishes.
#UPSTREAM=host.docker.internal:8000

# Ports on this machine. Change them only to try things out beside another
# web server: certificates for a public name need the standard ones.
#HTTP_PORT=80
#HTTPS_PORT=443
