DEBUG=1
SECRET_KEY=foo
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Behind a reverse proxy that provides HTTPS, such as the one in the caddy folder
#DJANGO_CSRF_TRUSTED_ORIGINS=https://maps.example.org
#DJANGO_BEHIND_HTTPS_PROXY=1
#DJANGO_DB_NAME=db_settings
DJANGO_DB_HOST=host.docker.internal
DJANGO_DB_PASSWORD=password
DJANGO_DB_USER=pycrocosm
#DJANGO_DB_PORT=5432
# pgmap's own settings (pgmap/config.cfg) can be given here instead, as the
# setting's name in capitals after PGMAP_. pgmap's command line tools read
# these as well as the web server. The DJANGO_MAP_DB_* variables below take
# precedence over them for the web server.
#PGMAP_DBNAME=db_map
#PGMAP_DBHOST=127.0.0.1
#PGMAP_DBPORT=5432
#PGMAP_DBUSER=pycrocosm
#PGMAP_DBPASS=password
#PGMAP_DBTABLEPREFIX=planet_static_
#PGMAP_DBTABLEMODIFYPREFIX=pycrocosm_mod_
#PGMAP_DBTABLETESTPREFIX=pycrocosm_test_
# The map database uses the DJANGO_DB_* user, password, host and port above
# unless given its own. Its name and table prefixes have their own variables.
#DJANGO_MAP_DB_NAME=db_map
#DJANGO_MAP_DB_USER=
#DJANGO_MAP_DB_PASSWORD=
#DJANGO_MAP_DB_HOST=
#DJANGO_MAP_DB_PORT=
#DJANGO_MAP_DB_PREFIX=planet_static_
#DJANGO_MAP_DB_PREFIX_MOD=planet_mod_
#DJANGO_MAP_DB_PREFIX_TEST=planet_test_
DJANGO_SETTINGS_MODULE=pycrocosm.settings
#OAUTH2_JWT_SECRET=
#OIDC_RSA_PRIVATE_KEY=
